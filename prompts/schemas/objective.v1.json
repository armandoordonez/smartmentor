{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/objective.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.diagnostic.Objective; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (Objective, v2).",
  "$defs": {
    "Meta": {
      "additionalProperties": false,
      "description": "Traceability of an LLM-generated output.",
      "properties": {
        "prompt_id": {
          "description": "Prompt id from prompts/catalog.yaml, e.g. topic_quiz",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "description": "Prompt file version, e.g. v1",
          "pattern": "^v\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "description": "Provider model name used for the call",
          "title": "Model",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_sha256": {
          "description": "Cache key (SHA-256)",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "model",
        "generated_at",
        "input_sha256"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "origin": {
      "enum": [
        "path_default",
        "llm_proposed",
        "learner_edited"
      ],
      "title": "Origin",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "bloom_verb": {
      "minLength": 1,
      "title": "Bloom Verb",
      "type": "string"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "criterion": {
      "description": "Empty criterion = OBJECTIVE_NOT_MEASURABLE",
      "minLength": 1,
      "title": "Criterion",
      "type": "string"
    },
    "focus_topics": {
      "items": {
        "type": "string"
      },
      "title": "Focus Topics",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meta"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Present when origin is llm_proposed"
    }
  },
  "required": [
    "origin",
    "statement",
    "bloom_verb",
    "content",
    "criterion",
    "focus_topics",
    "rationale"
  ],
  "title": "Objective",
  "type": "object"
}
