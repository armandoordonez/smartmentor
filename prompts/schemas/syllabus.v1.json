{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/syllabus.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.syllabus.Syllabus; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (Syllabus, v2).",
  "$defs": {
    "LearningOutcome": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^lo_[a-z0-9_]+_\\d+$",
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "bloom_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "title": "Bloom Level",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "bloom_level"
      ],
      "title": "LearningOutcome",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Traceability of an LLM-generated output.",
      "properties": {
        "prompt_id": {
          "description": "Prompt id from prompts/catalog.yaml, e.g. topic_quiz",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "description": "Prompt file version, e.g. v1",
          "pattern": "^v\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "description": "Provider model name used for the call",
          "title": "Model",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_sha256": {
          "description": "Cache key (SHA-256)",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "model",
        "generated_at",
        "input_sha256"
      ],
      "title": "Meta",
      "type": "object"
    },
    "SyllabusTopic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Extraction key (stored in topics.extraction_key)",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "subtopics": {
          "items": {
            "type": "string"
          },
          "title": "Subtopics",
          "type": "array"
        },
        "learning_outcomes": {
          "items": {
            "$ref": "#/$defs/LearningOutcome"
          },
          "minItems": 1,
          "title": "Learning Outcomes",
          "type": "array"
        },
        "bloom_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "title": "Bloom Level",
          "type": "string"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "estimated_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when the syllabus does not state it (L-05)",
          "title": "Estimated Minutes"
        },
        "is_mandatory": {
          "default": false,
          "title": "Is Mandatory",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "subtopics",
        "learning_outcomes",
        "bloom_level",
        "prerequisites"
      ],
      "title": "SyllabusTopic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "course_key": {
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "title": "Course Key",
      "type": "string"
    },
    "course_name": {
      "minLength": 1,
      "title": "Course Name",
      "type": "string"
    },
    "default_objective": {
      "title": "Default Objective",
      "type": "string"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/SyllabusTopic"
      },
      "minItems": 1,
      "title": "Topics",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "course_key",
    "course_name",
    "default_objective",
    "topics",
    "meta"
  ],
  "title": "Syllabus",
  "type": "object"
}
