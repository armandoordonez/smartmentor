{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/diagnostic_result.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.diagnostic.DiagnosticResult; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (Diagnostic.level_by_topic (TopicLevel), v2).",
  "$defs": {
    "LevelThresholds": {
      "additionalProperties": false,
      "properties": {
        "mastery_skip_threshold": {
          "description": "Mastered at or above",
          "maximum": 100,
          "minimum": 0,
          "title": "Mastery Skip Threshold",
          "type": "number"
        },
        "reinforce_cutoff": {
          "description": "To reinforce at or above",
          "maximum": 100,
          "minimum": 0,
          "title": "Reinforce Cutoff",
          "type": "number"
        }
      },
      "required": [
        "mastery_skip_threshold",
        "reinforce_cutoff"
      ],
      "title": "LevelThresholds",
      "type": "object"
    },
    "LevelWeights": {
      "additionalProperties": false,
      "description": "Weights of each signal; they add up to 1 (80/10/10 by default, C-02).",
      "properties": {
        "test": {
          "maximum": 1,
          "minimum": 0,
          "title": "Test",
          "type": "number"
        },
        "profile": {
          "maximum": 1,
          "minimum": 0,
          "title": "Profile",
          "type": "number"
        },
        "resume": {
          "maximum": 1,
          "minimum": 0,
          "title": "Resume",
          "type": "number"
        }
      },
      "required": [
        "test",
        "profile",
        "resume"
      ],
      "title": "LevelWeights",
      "type": "object"
    },
    "TopicLevel": {
      "additionalProperties": false,
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "test_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Difficulty-weighted hits; «No lo sé» counts as a miss",
          "title": "Test Score"
        },
        "profile_similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cosine profile vs topic",
          "title": "Profile Similarity"
        },
        "profile_prior": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Normalised similarity",
          "title": "Profile Prior"
        },
        "resume_prior": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resume signal (DEF-10)",
          "title": "Resume Prior"
        },
        "weights": {
          "$ref": "#/$defs/LevelWeights",
          "description": "Weights actually applied (redistributed)"
        },
        "level": {
          "maximum": 100,
          "minimum": 0,
          "title": "Level",
          "type": "number"
        },
        "classification": {
          "enum": [
            "mastered",
            "to_reinforce",
            "to_learn"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "test_score",
        "profile_similarity",
        "profile_prior",
        "resume_prior",
        "weights",
        "level",
        "classification"
      ],
      "title": "TopicLevel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of ``levels.estimate`` (``diagnostics.level_by_topic`` in the API).",
  "properties": {
    "algorithm": {
      "description": "Algorithm and version, e.g. weighted_difficulty v1",
      "title": "Algorithm",
      "type": "string"
    },
    "configured_weights": {
      "$ref": "#/$defs/LevelWeights",
      "description": "Weights of the learning path"
    },
    "thresholds": {
      "$ref": "#/$defs/LevelThresholds"
    },
    "level_by_topic": {
      "items": {
        "$ref": "#/$defs/TopicLevel"
      },
      "minItems": 1,
      "title": "Level By Topic",
      "type": "array"
    },
    "overall_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Overall Score",
      "type": "number"
    }
  },
  "required": [
    "algorithm",
    "configured_weights",
    "thresholds",
    "level_by_topic",
    "overall_score"
  ],
  "title": "DiagnosticResult",
  "type": "object"
}
