{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/simulated_answers.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.assessment.SimulatedAnswers; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (SimulatedAnswers, v2).",
  "$defs": {
    "LearnerAnswer": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "selected_option": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option"
        },
        "dont_know": {
          "default": false,
          "title": "Dont Know",
          "type": "boolean"
        },
        "text_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Answer"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "LearnerAnswer",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Traceability of an LLM-generated output.",
      "properties": {
        "prompt_id": {
          "description": "Prompt id from prompts/catalog.yaml, e.g. topic_quiz",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "description": "Prompt file version, e.g. v1",
          "pattern": "^v\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "description": "Provider model name used for the call",
          "title": "Model",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_sha256": {
          "description": "Cache key (SHA-256)",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "model",
        "generated_at",
        "input_sha256"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of ``eval.simulate_learner`` (evaluation harness only).",
  "properties": {
    "answers": {
      "items": {
        "$ref": "#/$defs/LearnerAnswer"
      },
      "title": "Answers",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "answers",
    "meta"
  ],
  "title": "SimulatedAnswers",
  "type": "object"
}
