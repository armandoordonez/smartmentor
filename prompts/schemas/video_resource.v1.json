        },
        "characterization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Subtopics the video covers (closed list of the topic)",
          "title": "Characterization"
        },
        "characterization_source": {
          "anyOf": [
            {
              "enum": [
                "metadata",
                "transcript",
                "instructor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
