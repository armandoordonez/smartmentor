            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 639-1",
          "title": "Language"
        },
        "has_captions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
