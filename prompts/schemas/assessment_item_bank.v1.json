{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/assessment_item_bank.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.assessment.AssessmentItemBank; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (DiagnosticLLM + Quiz + FinalAssessment (unified), v2).",
  "$defs": {
    "AssessmentItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "outcome_id": {
          "title": "Outcome Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "diagnostic",
            "topic_quiz",
            "final",
            "retention"
          ],
          "title": "Source",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "multiple_choice",
            "short_answer"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "bloom_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "title": "Bloom Level",
          "type": "string"
        },
        "difficulty": {
          "maximum": 3,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "correct_option": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correct Option"
        },
        "model_answer": {
          "title": "Model Answer",
          "type": "string"
        },
        "rubric": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "title": "Rubric",
          "type": "array"
        },
        "equivalence_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equivalence Group"
        }
      },
      "required": [
        "id",
        "topic_id",
        "outcome_id",
        "source",
        "item_type",
        "bloom_level",
        "difficulty",
        "stem",
        "options",
        "model_answer",
        "rubric"
      ],
      "title": "AssessmentItem",
      "type": "object"
    },
    "ItemReview": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "single_correct_answer": {
          "title": "Single Correct Answer",
          "type": "boolean"
        },
        "clear_stem": {
          "title": "Clear Stem",
          "type": "boolean"
        },
        "bloom_matches": {
          "title": "Bloom Matches",
          "type": "boolean"
        },
        "aligned_with_outcome": {
          "title": "Aligned With Outcome",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "single_correct_answer",
        "clear_stem",
        "bloom_matches",
        "aligned_with_outcome",
        "issues"
      ],
      "title": "ItemReview",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Traceability of an LLM-generated output.",
      "properties": {
        "prompt_id": {
          "description": "Prompt id from prompts/catalog.yaml, e.g. topic_quiz",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "description": "Prompt file version, e.g. v1",
          "pattern": "^v\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "description": "Provider model name used for the call",
          "title": "Model",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_sha256": {
          "description": "Cache key (SHA-256)",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "model",
        "generated_at",
        "input_sha256"
      ],
      "title": "Meta",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "points": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Points",
          "type": "number"
        }
      },
      "required": [
        "criterion",
        "points"
      ],
      "title": "RubricCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of ``diagnostic.generate_items``, ``items.generate_quiz_bank`` and\n``items.generate_final_bank``: items plus their automatic review.",
  "properties": {
    "topic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set for topic quiz banks",
      "title": "Topic Id"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AssessmentItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "item_reviews": {
      "items": {
        "$ref": "#/$defs/ItemReview"
      },
      "title": "Item Reviews",
      "type": "array"
    },
    "discarded_item_ids": {
      "description": "Items without a single correct answer; stored as auto_rejected",
      "items": {
        "type": "string"
      },
      "title": "Discarded Item Ids",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "items",
    "item_reviews",
    "discarded_item_ids",
    "meta"
  ],
  "title": "AssessmentItemBank",
  "type": "object"
}
