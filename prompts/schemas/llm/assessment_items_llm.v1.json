{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/llm/assessment_items_llm.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.assessment.AssessmentItemsLLM; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (DiagnosticLLM + QuizLLM (unified), v2).",
  "$defs": {
    "AssessmentItemLLM": {
      "properties": {
        "id": {
          "description": "Key inside the generated batch (d_<topic>_<n>, q<n>, f<n>)",
          "title": "Id",
          "type": "string"
        },
        "topic_id": {
          "description": "Topic id from the syllabus",
          "title": "Topic Id",
          "type": "string"
        },
        "outcome_id": {
          "description": "Learning outcome id the item assesses",
          "title": "Outcome Id",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "multiple_choice",
            "short_answer"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "bloom_level": {
          "enum": [
            "remember",
            "understand",
            "apply",
            "analyze",
            "evaluate",
            "create"
          ],
          "title": "Bloom Level",
          "type": "string"
        },
        "difficulty": {
          "description": "1 = low (remember), 2 = medium (apply), 3 = high (analyze)",
          "title": "Difficulty",
          "type": "integer"
        },
        "stem": {
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "description": "4 options in multiple choice; empty in short answer",
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "correct_option": {
          "description": "0-based index of the correct option; -1 in short answer",
          "title": "Correct Option",
          "type": "integer"
        },
        "model_answer": {
          "description": "Rationale of the correct option and of each distractor (multiple choice) or expected answer (short answer)",
          "title": "Model Answer",
          "type": "string"
        },
        "rubric": {
          "description": "Only short answer; empty otherwise",
          "items": {
            "$ref": "#/$defs/RubricCriterionLLM"
          },
          "title": "Rubric",
          "type": "array"
        },
        "equivalence_group": {
          "description": "Same value for parallel items (final and retention); empty when not used",
          "title": "Equivalence Group",
          "type": "string"
        }
      },
      "required": [
        "id",
        "topic_id",
        "outcome_id",
        "item_type",
        "bloom_level",
        "difficulty",
        "stem",
        "options",
        "correct_option",
        "model_answer",
        "rubric",
        "equivalence_group"
      ],
      "title": "AssessmentItemLLM",
      "type": "object"
    },
    "RubricCriterionLLM": {
      "properties": {
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "points": {
          "description": "Points of the criterion; the rubric adds up to 1",
          "title": "Points",
          "type": "number"
        }
      },
      "required": [
        "criterion",
        "points"
      ],
      "title": "RubricCriterionLLM",
      "type": "object"
    }
  },
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AssessmentItemLLM"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "AssessmentItemsLLM",
  "type": "object"
}
