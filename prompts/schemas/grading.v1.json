{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmentor/schemas/grading.v1.json",
  "$comment": "Generated by ai/scripts/export_schemas.py from app.domain.contracts.grading.AnswerGrading; do not edit by hand. Origin: design/04-prueba-mago-de-oz/smartmentor_mago_de_oz_gemini_v2.ipynb (Grading.results (QuestionResult), v2).",
  "$defs": {
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "met": {
          "title": "Met",
          "type": "boolean"
        },
        "points": {
          "description": "Points of the criterion in the rubric",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Points",
          "type": "number"
        },
        "points_awarded": {
          "maximum": 1,
          "minimum": 0,
          "title": "Points Awarded",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "met",
        "points",
        "points_awarded",
        "evidence"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Traceability of an LLM-generated output.",
      "properties": {
        "prompt_id": {
          "description": "Prompt id from prompts/catalog.yaml, e.g. topic_quiz",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "description": "Prompt file version, e.g. v1",
          "pattern": "^v\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "description": "Provider model name used for the call",
          "title": "Model",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_sha256": {
          "description": "Cache key (SHA-256)",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "model",
        "generated_at",
        "input_sha256"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Grade of one answer (``attempt_answers`` in the API).",
  "properties": {
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "item_type": {
      "enum": [
        "multiple_choice",
        "short_answer"
      ],
      "title": "Item Type",
      "type": "string"
    },
    "grader": {
      "enum": [
        "rule",
        "llm_judge",
        "human"
      ],
      "title": "Grader",
      "type": "string"
    },
    "approval_rule": {
      "enum": [
        "single_correct_option",
        "min_criteria_ratio"
      ],
      "title": "Approval Rule",
      "type": "string"
    },
    "min_criteria_ratio": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Short answer pass rule; 2/3 by default (DEF-21)",
      "title": "Min Criteria Ratio"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "is_correct": {
      "title": "Is Correct",
      "type": "boolean"
    },
    "criteria_met": {
      "minimum": 0,
      "title": "Criteria Met",
      "type": "integer"
    },
    "criteria_total": {
      "minimum": 0,
      "title": "Criteria Total",
      "type": "integer"
    },
    "rubric_detail": {
      "items": {
        "$ref": "#/$defs/CriterionResult"
      },
      "title": "Rubric Detail",
      "type": "array"
    },
    "feedback": {
      "title": "Feedback",
      "type": "string"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meta"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Present when grader is llm_judge"
    }
  },
  "required": [
    "item_id",
    "item_type",
    "grader",
    "approval_rule",
    "score",
    "is_correct",
    "criteria_met",
    "criteria_total",
    "rubric_detail",
    "feedback"
  ],
  "title": "AnswerGrading",
  "type": "object"
}
