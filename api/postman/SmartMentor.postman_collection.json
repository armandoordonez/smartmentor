{
  "info": {
    "name": "SmartMentor API (local)",
    "description": "Colección de la API de SmartMentor v2 (generada desde docs/contracts/openapi-api.json con api/scripts/dev.sh postman). Antes de cada petición un script pide a Keycloak el token con usuario y contraseña (cliente smartmentor-dev-tools, solo desarrollo) y lo envía como Bearer. Configura username y password en el entorno «SmartMentor local». Las variables de ruta ({{course_id}}, {{topic_id}}, {{job_id}}...) se definen en el entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pide a Keycloak un token con usuario y contraseña (cliente de desarrollo) y lo reutiliza",
          "// hasta que está por vencer. Para pedir uno nuevo en CADA petición, pon always_new_token=true.",
          "const env = (name) => pm.environment.get(name);",
          "const tokenUrl = env(\"keycloak_url\") + \"/realms/\" + env(\"realm\") + \"/protocol/openid-connect/token\";",
          "const alwaysNew = env(\"always_new_token\") === \"true\";",
          "const expiresAt = Number(env(\"token_expires_at\") || 0);",
          "const stillValid = env(\"access_token\") && Date.now() < expiresAt - 10000;",
          "",
          "if (alwaysNew || !stillValid) {",
          "    pm.sendRequest({",
          "        url: tokenUrl,",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "        body: {",
          "            mode: \"urlencoded\",",
          "            urlencoded: [",
          "                { key: \"grant_type\", value: \"password\" },",
          "                { key: \"client_id\", value: env(\"client_id\") },",
          "                { key: \"username\", value: env(\"username\") },",
          "                { key: \"password\", value: env(\"password\") },",
          "                { key: \"scope\", value: \"openid profile email\" }",
          "            ]",
          "        }",
          "    }, function (err, res) {",
          "        if (err || res.code !== 200) {",
          "            throw new Error(\"No se pudo obtener el token de Keycloak: \" + (err || res.code + \" \" + res.text()));",
          "        }",
          "        const body = res.json();",
          "        pm.environment.set(\"access_token\", body.access_token);",
          "        pm.environment.set(\"token_expires_at\", String(Date.now() + body.expires_in * 1000));",
          "    });",
          "}"
        ]
      }
    }
  ],
