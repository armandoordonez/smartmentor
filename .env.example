# Variables de entorno sin secretos. Copiar a .env y completar.
# .env está ignorado por git; nunca se sube al repositorio.

# --- Zona horaria (Bogotá) ---
TZ=America/Bogota
APP_TIMEZONE=America/Bogota

# --- PostgreSQL (contenedor local, ver database/README.md) ---
POSTGRES_DB=smartmentor
POSTGRES_USER=smartmentor
POSTGRES_PASSWORD=change_me
# Puerto publicado en tu máquina (5432 suele estar ocupado por otros proyectos)
POSTGRES_PORT=5442

# --- Conexión de la API a la base de datos ---
# Dentro de docker compose el host es el nombre del servicio: postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smartmentor
DATABASE_USER=smartmentor
DATABASE_PASSWORD=change_me

# --- Respaldos (database/scripts/backup.sh) ---
# Días que se conservan las copias; vacío = no borrar
BACKUP_RETENTION_DAYS=

# --- API ---
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8020

# --- Embeddings (provisional, pendiente D-01) ---
EMBEDDING_DIMENSION=1024

# --- Identidad con Keycloak (pendiente D-03, fuera de alcance de esta entrega) ---
# OIDC_ISSUER_URL=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
