# Variables de entorno de SmartMentor. Copia este archivo a .env y completa los valores.
#
# REGLAS
#   * .env está ignorado por git: nunca se sube. Aquí NO se escriben valores reales.
#   * Todas las credenciales (usuarios, contraseñas, claves de API, secretos y nombres de modelos)
#     van AQUÍ, vacías, y se leen desde docker-compose.yml y los servicios. Ningún otro archivo
#     versionado debe contenerlas.
#   * Vacía = la define quien despliega. Los valores estructurales (zona horaria, puertos, hosts)
#     traen su valor por defecto; los puertos se pueden cambiar si chocan con otro proyecto.
#   * El compose se niega a arrancar si falta una credencial obligatoria y dice cuál.
#   * Una variable por línea, con su comentario en la línea anterior. No pongas comentarios
#     al final de la línea de un valor: scripts/gen-secrets.sh solo reconoce «VARIABLE=».
#
# CÓMO LEER LOS COMENTARIOS
#   [Obligatoria]  el compose o el servicio no arranca sin ella.
#   [Opcional]     tiene valor por defecto o el servicio funciona sin ella.
#   [Secreto]      contraseña, clave o secreto: scripts/gen-secrets.sh puede generarla (si se indica).
#   [Tú la defines] nombre, correo o clave de un proveedor externo: gen-secrets.sh no la inventa.
#
# PASOS
#   1. cp .env.example .env
#   2. scripts/gen-secrets.sh        # rellena SOLO las contraseñas y secretos vacíos (nunca imprime valores)
#   3. Completa a mano lo que gen-secrets.sh te indique: nombres de usuario, correo, modelos y claves.
#
# La comprobación scripts/check-env-coherence.py (y la CI) verifica que cada variable de este archivo
# se use y que cada variable que leen el compose y los servicios esté documentada aquí.

# =====================================================================================
# General
# =====================================================================================

# [Opcional] Zona horaria de los contenedores (registros, fechas del sistema).
TZ=America/Bogota
# [Opcional] Zona horaria con la que las aplicaciones muestran fechas (en la base se guarda siempre UTC).
APP_TIMEZONE=America/Bogota
# [Opcional] Ambiente: local | test | production. En production se rechaza APP_DATA_SOURCE=fixtures.
APP_ENV=local
# [Opcional] Nivel de los registros: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# [Opcional] Etiquetas visibles de los roles (glosario, ADR 0021): generic | academic | corporate.
APP_CONTEXT_PROFILE=generic

# =====================================================================================
# PostgreSQL (propietario de la base y de Liquibase; ver database/README.md)
# =====================================================================================

# [Opcional] Nombre de la base de datos de la aplicación.
POSTGRES_DB=smartmentor
# [Obligatoria · Tú la defines] Superusuario de PostgreSQL. Sugerido: smartmentor.
POSTGRES_USER=
# [Obligatoria · Secreto] Contraseña del superusuario. PostgreSQL la ignora si database/data/postgres ya existe.
POSTGRES_PASSWORD=
# [Opcional] Puerto de tu máquina donde se publica PostgreSQL (5432 suele estar ocupado por otros proyectos).
POSTGRES_PORT=5442
# [Opcional] Días que se conservan las copias de database/scripts/backup.sh; vacío = no borrar ninguna.
BACKUP_RETENTION_DAYS=

# =====================================================================================
# Conexión a la base desde los servicios
# =====================================================================================

# [Opcional] Host de PostgreSQL visto desde los contenedores (nombre del servicio del compose).
DATABASE_HOST=postgres
# [Opcional] Puerto interno de PostgreSQL (el del contenedor, no el publicado).
DATABASE_PORT=5432
# [Opcional] Base a la que se conectan los servicios.
DATABASE_NAME=smartmentor
# [Opcional] true = la API y el servicio de IA exigen TLS al conectarse (base en la nube, como Neon). Local: false.
DATABASE_SSL=false
# [Opcional] Parámetros JDBC que usan Liquibase y Keycloak. Base en la nube: ?sslmode=require. Local: vacío.
DATABASE_JDBC_PARAMS=
# [Opcional · Secreto · Tú la defines] URL del administrador de una base remota; solo la usa
# database/scripts/bootstrap.sh la primera vez (crea bases, roles y pgvector). Ver database/README.md.
# Ejemplo: postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
ADMIN_DATABASE_URL=

# =====================================================================================
# Usuarios de la base con mínimo privilegio (ADR 0019)
# =====================================================================================
# Los nombres son fijos: el changeset de permisos (v2.0.0-045) los usa tal cual. Con un volumen de
# PostgreSQL ya existente los roles no se crean solos: ejecuta database/scripts/bootstrap.sh o
# database/scripts/reset-app-schema.sh.

# [Obligatoria] Dueño del esquema: lo usa Liquibase para crear y migrar tablas.
OWNER_DATABASE_USER=smartmentor_owner
# [Obligatoria · Secreto] Contraseña del dueño del esquema.
OWNER_DATABASE_PASSWORD=
# [Obligatoria] Usuario con el que la API lee y escribe las tablas de negocio.
API_DATABASE_USER=smartmentor_api
# [Obligatoria · Secreto] Contraseña del usuario de la API.
API_DATABASE_PASSWORD=
# [Obligatoria] Usuario con el que el servicio de IA escribe sus tablas (ai_*, llm_call_logs...).
AI_DATABASE_USER=smartmentor_ai
# [Obligatoria · Secreto] Contraseña del usuario del servicio de IA.
AI_DATABASE_PASSWORD=
# [Opcional] Usuario de solo lectura para el notebook de métricas. Sin contraseña el rol no se crea.
METRICS_DATABASE_USER=smartmentor_metrics
# [Opcional · Secreto] Contraseña del usuario de métricas.
METRICS_DATABASE_PASSWORD=
# [Opcional · Tú la defines] Conexión que usa el notebook (la lee el cuaderno, no los servicios).
# Ejemplo: postgresql://smartmentor_metrics:CONTRASEÑA@localhost:5442/smartmentor
METRICS_DATABASE_URL=

# =====================================================================================
# API
# =====================================================================================

# [Opcional] Puerto de tu máquina donde se publica la API (8020; cámbialo si choca con otro proyecto).
API_PORT=8020

# =====================================================================================
# Interfaz (Streamlit; ver app/README.md)
# =====================================================================================

# [Opcional] api = API real con login de Keycloak; fixtures = datos fijos sin login (se rechaza con APP_ENV=production).
APP_DATA_SOURCE=api
# [Opcional] URL pública de la interfaz (define la URI de retorno /oauth2callback). Vacía = http://localhost:APP_PORT.
APP_PUBLIC_URL=
# [Opcional] La API vista desde el contenedor de la interfaz (red interna de Docker, puerto del contenedor 8000).
API_BASE_URL=http://api:8000
# [Opcional] Descubrimiento de Keycloak (OIDC) visto desde el contenedor de la interfaz.
OIDC_SERVER_METADATA_URL=http://keycloak:8080/realms/smartmentor/.well-known/openid-configuration
# [Opcional] Texto de la ventana del piloto que cita la pantalla A3b; vacío = el texto de la aplicación.
PILOT_WINDOW_TEXT=
# [Opcional] Puerto de tu máquina donde se publica la interfaz.
APP_PORT=8501
# [Obligatoria con APP_DATA_SOURCE=api · Secreto] Secreto de la cookie de sesión de st.login; sin él la app falla nombrándolo.
APP_COOKIE_SECRET=
# [Opcional] Identificador del cliente OIDC de la interfaz en Keycloak.
OIDC_UI_CLIENT_ID=smartmentor-ui
# [Obligatoria · Secreto] Secreto del cliente confidencial smartmentor-ui: el realm lo toma de esta variable al importarse.
OIDC_UI_CLIENT_SECRET=

# =====================================================================================
# Embeddings (D-01 / DEF-02)
# =====================================================================================

# [Opcional] Dimensión del vector. Debe coincidir con la columna vector(768) del esquema v2.0.0 (ADR 0012, G-09).
EMBEDDING_DIMENSION=768

# =====================================================================================
# Keycloak (ver keycloak/README.md)
# =====================================================================================

# [Obligatoria · Tú la defines] Administrador de la consola de Keycloak (se crea solo en el primer arranque). Sugerido: admin.
KEYCLOAK_ADMIN=
# [Obligatoria · Secreto] Contraseña de ese administrador de la consola.
KEYCLOAK_ADMIN_PASSWORD=
# [Opcional] Puerto de tu máquina donde se publica Keycloak (8080 suele estar ocupado).
KEYCLOAK_PORT=8180
# [Opcional] URL pública de Keycloak: la que ve el navegador y la que lleva el campo iss de los tokens.
# Vacía = http://localhost:KEYCLOAK_PORT. En producción: la URL HTTPS.
KC_HOSTNAME=
# [Opcional] Base de datos de Keycloak dentro del mismo PostgreSQL (separada de la de la aplicación).
KEYCLOAK_DB_NAME=keycloak
# [Obligatoria · Tú la defines] Rol de PostgreSQL dueño de la base de Keycloak. Sugerido: keycloak.
KEYCLOAK_DB_USER=
# [Obligatoria · Secreto] Contraseña de ese rol.
KEYCLOAK_DB_PASSWORD=

# =====================================================================================
# Segundo factor en la API
# =====================================================================================

# [Opcional] true = las rutas de instructor y administrador exigen que el token indique OTP (ADR 0014).
# Actívalo solo cuando Keycloak ya lo aplique y el token lo informe.
REQUIRE_SECOND_FACTOR=false

# =====================================================================================
# Autenticación de la API con Keycloak
# =====================================================================================

# [Obligatoria] Emisor (iss) de los tokens, tal como lo ve el cliente que inicia sesión.
OIDC_ISSUER_URL=http://localhost:8180/realms/smartmentor
# [Obligatoria] Audiencia (aud) que deben traer los tokens para la API.
OIDC_AUDIENCE=smartmentor-api
# [Obligatoria] Llaves públicas de firma; dentro del compose se usa la red interna (servicio keycloak).
OIDC_JWKS_URL=http://keycloak:8080/realms/smartmentor/protocol/openid-connect/certs
# [Opcional] Cliente con el que Swagger UI (/docs) pide el token. SOLO DESARROLLO: déjalo vacío en producción.
OIDC_DOCS_CLIENT_ID=

# =====================================================================================
# Servicio de IA: conexión desde la API (perfil de compose «ai»)
# =====================================================================================

# [Opcional] fake = la API usa un servicio de IA simulado (sin ai/); http = llama al servicio ai (perfil ai).
AI_SERVICE_MODE=fake
# [Opcional] Puerto de tu máquina donde se publica el servicio de IA (solo para Swagger en local).
AI_PORT=8030
# [Opcional] URL del servicio de IA vista desde la API (red interna de Docker).
AI_BASE_URL=http://ai:8030
# [Opcional] Cuenta de servicio con la que la API pide token al servicio de IA (client credentials).
AI_CLIENT_ID=smartmentor-api-service
# [Obligatoria · Secreto] Secreto de esa cuenta de servicio: el realm lo toma de esta variable.
AI_CLIENT_SECRET=
# [Opcional] Audiencia (aud) que exige el servicio de IA en los tokens que recibe.
AI_SERVICE_AUDIENCE=smartmentor-ai
# [Opcional] Endpoint de tokens para el client credentials; vacío = el interno de Keycloak (keycloak:8080).
AI_SERVICE_TOKEN_URL=
# [Opcional] Segundos de espera de cada llamada de la API al servicio de IA.
AI_SERVICE_TIMEOUT_SECONDS=10
# [Opcional] Cada cuántos segundos la API ingiere trabajos terminados del servicio de IA (0 lo desactiva).
AI_SWEEP_INTERVAL_SECONDS=60

# =====================================================================================
# Servicio de IA: modelos y claves (DEF-01 y DEF-02; sin valor por defecto en el código)
# =====================================================================================

# [Obligatoria con el perfil ai · Tú la defines] Proveedor del LLM: gemini | anthropic (por defecto se usa gemini).
AI_LLM_PROVIDER=
# [Obligatoria con el perfil ai · Tú la defines] Nombre exacto del modelo para generar contenido.
AI_LLM_MODEL_DEFAULT=
# [Obligatoria con el perfil ai · Tú la defines] Nombre exacto del modelo pequeño: revisión de ítems, calificación y texto del badge.
AI_LLM_MODEL_SMALL=
# [Obligatoria con el perfil ai · Tú la defines] Proveedor de embeddings (el mismo del notebook de Mago de Oz: gemini).
AI_EMBEDDING_PROVIDER=
# [Obligatoria con el perfil ai · Tú la defines] Nombre exacto del modelo de embeddings (dimensión 768).
AI_EMBEDDING_MODEL=
# [Secreto · Tú la defines] Clave de la API de Gemini; solo si AI_LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# [Secreto · Tú la defines] Clave de la API de Anthropic; solo si AI_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# [Opcional · Secreto · Tú la defines] Clave de YouTube Data API para buscar videos; sin ella el instructor carga la lista.
YOUTUBE_API_KEY=
# [Obligatoria con LLM real · Tú la defines] Tope diario en USD; vacío = el servicio no arranca con LLM real. Simulado en el plan (18.5): 5.
AI_DAILY_BUDGET_USD=
# [Obligatoria con LLM real · Tú la defines] Tope mensual en USD. Simulado: 30.
AI_MONTHLY_BUDGET_USD=
# [Obligatoria con LLM real · Tú la defines] Tope por curso en USD. Simulado: 2.
AI_COURSE_BUDGET_USD=
# [Obligatoria con LLM real · Tú la defines] Tope por inscripción en USD. Simulado: 0.50.
AI_ENROLLMENT_BUDGET_USD=
# [Opcional] 1 = el arnés de evaluación (ai/eval) llama al LLM real. Nunca en CI.
AI_EVAL_LIVE=0

# =====================================================================================
# Correo de Keycloak con Google (plan 18.6)
# =====================================================================================
# Con el perfil mail (Mailpit): SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false,
# SMTP_USER y SMTP_PASSWORD con cualquier texto, SMTP_FROM con cualquier dirección.

# [Obligatoria] Servidor SMTP: smtp.gmail.com (Google) o mailpit (desarrollo).
SMTP_HOST=smtp.gmail.com
# [Opcional] Puerto SMTP: 587 con STARTTLS (Google), 1025 con Mailpit.
SMTP_PORT=587
# [Opcional] true con Google; false con Mailpit.
SMTP_STARTTLS=true
# [Obligatoria con correo real · Tú la defines] Cuenta de Google que envía los correos.
SMTP_USER=
# [Obligatoria con correo real · Secreto · Tú la defines] Contraseña de aplicación de Google (no la de la cuenta).
SMTP_PASSWORD=
# [Obligatoria · Tú la defines] Dirección remitente de los correos (por ejemplo la misma cuenta de Google).
SMTP_FROM=
# [Opcional] Nombre que ven los destinatarios como remitente.
SMTP_FROM_DISPLAY_NAME=SmartMentor
# [Opcional] Puerto de la interfaz web de Mailpit (perfil mail), publicado solo en 127.0.0.1.
MAILPIT_UI_PORT=8025

# =====================================================================================
# Administrador inicial y organización (Fase 2; DEF-28)
# =====================================================================================

# [Opcional · Tú la defines] Correo del administrador que siembra Liquibase (vacío = no se siembra).
# Debe ser el mismo con el que crees al usuario en Keycloak. Antes del piloto, uno propio (plan 18.7).
SEED_ADMIN_EMAIL=
# [Opcional · Tú la defines] Correo del instructor de desarrollo que siembra Liquibase (vacío = no se siembra).
# En producción déjalo vacío. Para iniciar sesión también debe existir en Keycloak (keycloak/scripts/seed-dev-users.sh).
SEED_INSTRUCTOR_EMAIL=instructor.smartmentor@yopmail.com
# [Opcional · Tú la defines] Correo del aprendiz de desarrollo que siembra Liquibase (vacío = no se siembra). En producción, vacío.
SEED_LEARNER_EMAIL=learner.smartmentor@yopmail.com
# [Opcional · Secreto] Contraseña de desarrollo de los usuarios que crea keycloak/scripts/seed-dev-users.sh. Solo para pruebas locales.
SEED_USERS_PASSWORD=
# [Opcional · Tú la defines] Organización responsable que muestran los textos legales de la aplicación.
ORGANIZATION_NAME=

# =====================================================================================
# Insignias (Open Badges)
# =====================================================================================

# [Opcional · Tú la defines] Nombre del emisor que aparece en la insignia (E10).
BADGE_ISSUER_NAME=
# [Opcional · Tú la defines] URL del emisor de la insignia.
BADGE_ISSUER_URL=
