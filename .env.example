# Variables de entorno de SmartMentor. Copia este archivo a .env y completa los valores.
#
# REGLAS
#   * .env está ignorado por git: nunca se sube. Aquí NO se escriben valores reales.
#   * Todas las credenciales (usuarios, contraseñas, claves de API, secretos y nombres de modelos)
#     van AQUÍ, vacías, y se leen desde docker-compose.yml y los servicios. Ningún otro archivo
#     versionado debe contenerlas.
#   * Vacía = la define quien despliega. Los valores estructurales (zona horaria, puertos, hosts)
#     traen su valor por defecto; los puertos se pueden cambiar si chocan con otro proyecto.
#   * El compose se niega a arrancar si falta una credencial obligatoria y dice cuál.
#   * Una variable por línea, con su comentario en la línea anterior. No pongas comentarios
#     al final de la línea de un valor: scripts/gen-secrets.sh solo reconoce «VARIABLE=».
#
# PASOS
#   1. cp .env.example .env
#   2. scripts/gen-secrets.sh        # rellena SOLO las contraseñas y secretos vacíos (nunca imprime valores)
#   3. Completa a mano lo que gen-secrets.sh te indique: nombres de usuario, correo, modelos y claves.
#
# La comprobación scripts/check-env-coherence.py (y la CI) verifica que cada variable de este archivo
# se use y que cada variable que leen el compose y los servicios esté documentada aquí.

# --- General ---
TZ=America/Bogota
APP_TIMEZONE=America/Bogota
# local | test | production
APP_ENV=local
LOG_LEVEL=INFO

# Etiquetas de los roles (glosario configurable, ADR 0021): generic | academic | corporate
APP_CONTEXT_PROFILE=generic

# --- PostgreSQL (propietario de la base y de Liquibase; ver database/README.md) ---
POSTGRES_DB=smartmentor
# Sugerido: smartmentor
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5442
# Días que se conservan las copias de database/scripts/backup.sh; vacío = no borrar
BACKUP_RETENTION_DAYS=

# --- Conexión a la base desde los servicios ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smartmentor

# --- Usuarios de la base con mínimo privilegio (ADR 0019) ---
# Los nombres son fijos: el changeset de permisos (v2.0.0-045) los usa tal cual. Con un volumen de
# PostgreSQL ya existente los roles no se crean solos: ejecuta database/scripts/bootstrap.sh.
# Dueño del esquema (lo usa Liquibase)
OWNER_DATABASE_USER=smartmentor_owner
OWNER_DATABASE_PASSWORD=
API_DATABASE_USER=smartmentor_api
API_DATABASE_PASSWORD=
AI_DATABASE_USER=smartmentor_ai
AI_DATABASE_PASSWORD=
# Solo lectura, para el notebook de métricas. Opcional: sin contraseña el rol no se crea
METRICS_DATABASE_USER=smartmentor_metrics
METRICS_DATABASE_PASSWORD=
# Conexión que usa el notebook (la lee el cuaderno, no los servicios). Ejemplo: postgresql://usuario:contraseña@localhost:5442/smartmentor
METRICS_DATABASE_URL=

# --- API ---
API_PORT=8020

# --- Interfaz (Streamlit; ver app/README.md) ---
# api = API real con login de Keycloak; fixtures = datos fijos sin login (se rechaza con APP_ENV=production)
APP_DATA_SOURCE=api
# URL pública de la interfaz (define la URI de retorno /oauth2callback). Vacía = http://localhost:APP_PORT
APP_PUBLIC_URL=
# La API por la red interna de Docker (puerto del contenedor, 8000)
API_BASE_URL=http://api:8000
# Descubrimiento de Keycloak desde el contenedor de la interfaz
OIDC_SERVER_METADATA_URL=http://keycloak:8080/realms/smartmentor/.well-known/openid-configuration
# Texto de la ventana del piloto que cita la pantalla A3b; vacío = el de la aplicación
PILOT_WINDOW_TEXT=
APP_PORT=8501
# Secreto de la cookie de sesión de st.login (obligatorio con APP_DATA_SOURCE=api: sin él la app falla nombrándolo)
APP_COOKIE_SECRET=
OIDC_UI_CLIENT_ID=smartmentor-ui
# Secreto del cliente confidencial smartmentor-ui: el realm lo toma de esta variable al importarse
OIDC_UI_CLIENT_SECRET=

# --- Embeddings (D-01 / DEF-02) ---
# Debe coincidir con la columna vector(768) del esquema v2.0.0 (ADR 0012, G-09)
EMBEDDING_DIMENSION=768

# --- Keycloak (ver keycloak/README.md) ---
# Administrador de la consola de Keycloak (se crea solo en el primer arranque). Sugerido: admin
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
# URL pública de Keycloak (la que ve el navegador y la que lleva el campo iss de los tokens).
# Vacía = http://localhost:KEYCLOAK_PORT. En producción: la URL HTTPS.
KC_HOSTNAME=
# Keycloak guarda sus datos en el PostgreSQL del proyecto, en su propia base y con su propio rol
KEYCLOAK_DB_NAME=keycloak
# Sugerido: keycloak
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# --- Autenticación de la API con Keycloak (obligatorias: la API no arranca sin ellas) ---
OIDC_ISSUER_URL=http://localhost:8180/realms/smartmentor
OIDC_AUDIENCE=smartmentor-api
OIDC_JWKS_URL=http://keycloak:8080/realms/smartmentor/protocol/openid-connect/certs
# Cliente con el que Swagger UI (/docs) pide el token. SOLO DESARROLLO: vacío en producción
OIDC_DOCS_CLIENT_ID=

# --- Servicio de IA: conexión desde la API (perfil de compose ai) ---
AI_PORT=8030
AI_BASE_URL=http://ai:8030
AI_CLIENT_ID=smartmentor-api-service
# Secreto de la cuenta de servicio smartmentor-api-service: el realm lo toma de esta variable
AI_CLIENT_SECRET=
# Audiencia (aud) que exige ai/ en los tokens que recibe
AI_SERVICE_AUDIENCE=smartmentor-ai

# --- Servicio de IA: modelos y claves (DEF-01 y DEF-02; sin valor por defecto en el código) ---
# gemini | anthropic
AI_LLM_PROVIDER=
# Modelo para generar contenido
AI_LLM_MODEL_DEFAULT=
# Modelo pequeño: revisión de ítems, calificación, texto del badge
AI_LLM_MODEL_SMALL=
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
# Solo si AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Solo si AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Búsqueda de videos; sin ella el instructor carga la lista
YOUTUBE_API_KEY=
# Topes en USD; vacío = el servicio no arranca con LLM real (simulados en el plan, 18.5: 5, 30, 2 y 0.50)
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_COURSE_BUDGET_USD=
AI_ENROLLMENT_BUDGET_USD=
# 1 = el arnés de evaluación llama al LLM real (nunca en CI)
AI_EVAL_LIVE=0

# --- Correo de Keycloak con Google (plan 18.6) ---
# Con el perfil mail (Mailpit): SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false,
# SMTP_USER y SMTP_PASSWORD con cualquier texto, SMTP_FROM con cualquier dirección.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# Cuenta de Google que envía
SMTP_USER=
# Contraseña de aplicación de Google, no la de la cuenta
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=SmartMentor
# Puerto de la interfaz web de Mailpit (perfil mail), solo en 127.0.0.1
MAILPIT_UI_PORT=8025

# --- Administrador inicial y organización (Fase 2; DEF-28) ---
# Correo del administrador sembrado por Liquibase (vacío = no se siembra); antes del piloto, uno propio (plan 18.7)
SEED_ADMIN_EMAIL=
# Organización responsable que muestran los textos legales
ORGANIZATION_NAME=

# --- Insignias (Open Badges) ---
BADGE_ISSUER_NAME=
BADGE_ISSUER_URL=
