# Variables de entorno sin secretos. Copiar a .env y completar.
# .env está ignorado por git; nunca se sube al repositorio.

# --- Zona horaria (Bogotá) ---
TZ=America/Bogota
APP_TIMEZONE=America/Bogota

# --- PostgreSQL (contenedor local, ver database/README.md) ---
POSTGRES_DB=smartmentor
POSTGRES_USER=smartmentor
POSTGRES_PASSWORD=change_me
# Puerto publicado en tu máquina (5432 suele estar ocupado por otros proyectos)
POSTGRES_PORT=5442

# --- Conexión de la API a la base de datos ---
# Dentro de docker compose el host es el nombre del servicio: postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smartmentor
DATABASE_USER=smartmentor
DATABASE_PASSWORD=change_me

# --- Respaldos (database/scripts/backup.sh) ---
# Días que se conservan las copias; vacío = no borrar
BACKUP_RETENTION_DAYS=

# --- API ---
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8020

# --- Embeddings (provisional, pendiente D-01) ---
EMBEDDING_DIMENSION=1024

# --- Keycloak (proveedor de identidad; ver keycloak/README.md) ---
# Administrador de la consola de Keycloak (se crea solo en el primer arranque)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
# Puerto publicado en tu máquina (8080 suele estar ocupado por otros proyectos)
KEYCLOAK_PORT=8180
# Keycloak guarda sus datos en el PostgreSQL del proyecto, en su propia base y con su propio rol
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me

# --- Autenticación de la API con Keycloak (obligatorias: la API no arranca sin ellas) ---
# Emisor (iss) de los tokens, tal como lo ve el cliente que inicia sesión
OIDC_ISSUER_URL=http://localhost:8180/realms/smartmentor
# Audiencia (aud) que deben traer los tokens (ver keycloak/README.md: mapper de audiencia)
OIDC_AUDIENCE=smartmentor-api
# Llaves públicas: dentro de docker compose se usa la red interna (nombre del servicio keycloak)
OIDC_JWKS_URL=http://keycloak:8080/realms/smartmentor/protocol/openid-connect/certs
# Cliente con el que Swagger UI (/docs) pide el token con usuario y contraseña. SOLO DESARROLLO:
# déjalo vacío en producción para que /docs acepte únicamente un token pegado.
OIDC_DOCS_CLIENT_ID=smartmentor-dev-tools
