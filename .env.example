# Variables de entorno de SmartMentor. Copia este archivo a .env y completa los valores.
#
# REGLAS
#   * .env está ignorado por git: nunca se sube. Aquí NO se escriben valores reales.
#   * Todas las credenciales (usuarios, contraseñas, claves de API, secretos y nombres de modelos)
#     van AQUÍ, vacías, y se leen desde docker-compose.yml y los servicios. Ningún otro archivo
#     versionado debe contenerlas.
#   * Vacía = la define quien despliega. Los valores estructurales (zona horaria, puertos, hosts)
#     traen su valor por defecto; los puertos se pueden cambiar si chocan con otro proyecto.
#   * El compose se niega a arrancar si falta una credencial obligatoria.

# --- General ---
TZ=America/Bogota
APP_TIMEZONE=America/Bogota
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL (propietario de la base; ver database/README.md) ---
POSTGRES_DB=smartmentor
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5442

# --- Conexión de la API a la base de datos ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smartmentor
DATABASE_USER=
DATABASE_PASSWORD=

# --- Respaldos (database/scripts/backup.sh) ---
# Días que se conservan las copias; vacío = no borrar
BACKUP_RETENTION_DAYS=

# --- API ---
API_PORT=8020

# --- Interfaz (Streamlit; ver app/README.md) ---
# sample = datos de ejemplo sin login (único modo disponible por ahora)
APP_DATA_SOURCE=sample
APP_PORT=8501

# --- Embeddings (D-01 / DEF-02) ---
# Provisional hasta confirmar el modelo; debe coincidir con la columna vector(N)
EMBEDDING_DIMENSION=1024

# --- Keycloak (ver keycloak/README.md) ---
# Administrador de la consola de Keycloak (se crea solo en el primer arranque)
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
# Keycloak guarda sus datos en el PostgreSQL del proyecto, en su propia base y con su propio rol
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# --- Autenticación de la API con Keycloak (obligatorias: la API no arranca sin ellas) ---
OIDC_ISSUER_URL=http://localhost:8180/realms/smartmentor
OIDC_AUDIENCE=smartmentor-api
OIDC_JWKS_URL=http://keycloak:8080/realms/smartmentor/protocol/openid-connect/certs
# Cliente con el que Swagger UI (/docs) pide el token. SOLO DESARROLLO: vacío en producción
OIDC_DOCS_CLIENT_ID=

# =====================================================================================
# Variables de las fases siguientes (plan de implementación v3, Anexo D). Todavía no las
# lee ningún servicio; se documentan aquí para que el .env se complete una sola vez.
# =====================================================================================

# --- Interfaz con login (Fase 7) ---
APP_COOKIE_SECRET=
OIDC_UI_CLIENT_ID=
OIDC_UI_CLIENT_SECRET=

# --- Usuarios de base de datos con mínimo privilegio (Fase 2, D-05) ---
API_DATABASE_USER=
API_DATABASE_PASSWORD=
AI_DATABASE_USER=
AI_DATABASE_PASSWORD=

# --- Servicio de IA: conexión desde la API (Fase 4) ---
AI_PORT=8030
AI_BASE_URL=http://ai:8030
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_SERVICE_AUDIENCE=smartmentor-ai

# --- Servicio de IA: modelos y claves (Fases 4 y 5; DEF-01 y DEF-02) ---
# Proveedor por defecto: gemini (también admite anthropic por el mismo puerto)
AI_LLM_PROVIDER=
AI_LLM_MODEL_DEFAULT=
AI_LLM_MODEL_SMALL=
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# Topes en USD; vacío = el servicio no arranca con LLM real (simulados en el plan, 18.5)
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_COURSE_BUDGET_USD=
AI_ENROLLMENT_BUDGET_USD=
# 1 = el arnés de evaluación llama al LLM real (nunca en CI)
AI_EVAL_LIVE=0

# --- Correo de Keycloak con Google (Fase 8; plan 18.6) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=SmartMentor

# --- Administrador inicial y organización (Fase 2; DEF-28) ---
SEED_ADMIN_EMAIL=
ORGANIZATION_NAME=

# --- Insignias (Open Badges) ---
BADGE_ISSUER_NAME=
BADGE_ISSUER_URL=
