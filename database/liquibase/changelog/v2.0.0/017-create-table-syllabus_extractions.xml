<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="v2.0.0/017-create-table-syllabus_extractions.xml">

    <changeSet id="v2.0.0-017-create-table-syllabus_extractions" author="eduar.troyano">
        <comment>Crea la tabla syllabus_extractions: salidas crudas de cada extracción del syllabus; solo una vigente por curso. Incluye secuencia propia, tabla de auditoría syllabus_extractions_audit y el trigger syllabus_extractions_audit_trg.</comment>

        <createSequence sequenceName="syllabus_extractions_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="syllabus_extractions_audit_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="syllabus_extractions" remarks="Raw outputs of the syllabus extraction, one per extraction run">
            <column name="id" type="bigint" defaultValueSequenceNext="syllabus_extractions_id_seq" remarks="Primary key">
                <constraints primaryKey="true" primaryKeyName="syllabus_extractions_pkey" nullable="false"/>
            </column>
            <column name="course_id" type="bigint" remarks="Course the extraction belongs to">
                <constraints nullable="false" foreignKeyName="syllabus_extractions_course_id_fk" references="courses(id)"/>
            </column>
            <column name="syllabus_document_id" type="bigint" remarks="Syllabus document that was processed">
                <constraints nullable="false" foreignKeyName="syllabus_extractions_syllabus_document_id_fk" references="syllabus_documents(id)"/>
            </column>
            <column name="ai_job_id" type="bigint" remarks="AI job that produced the extraction">
                <constraints foreignKeyName="syllabus_extractions_ai_job_id_fk" references="ai_jobs(id)"/>
            </column>
            <column name="raw_output" type="jsonb" remarks="Raw output of the model validated against syllabus.v1">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_version" type="varchar(50)" remarks="Version of the prompt used"/>
            <column name="is_current" type="boolean" defaultValueComputed="true" remarks="Whether this is the extraction currently shown to the instructor">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true" remarks="Logical state: false means deactivated (rows are never deleted)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Last update timestamp, maintained by the set_updated_at trigger">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="syllabus_extractions" indexName="syllabus_extractions_course_id_idx">
            <column name="course_id"/>
        </createIndex>
        <createIndex tableName="syllabus_extractions" indexName="syllabus_extractions_document_idx">
            <column name="syllabus_document_id"/>
        </createIndex>
        <sql>CREATE UNIQUE INDEX syllabus_extractions_current_uq ON syllabus_extractions (course_id) WHERE is_current</sql>
        <sql>CREATE TRIGGER syllabus_extractions_set_updated_at_trg BEFORE UPDATE ON syllabus_extractions FOR EACH ROW EXECUTE FUNCTION set_updated_at()</sql>

        <createTable tableName="syllabus_extractions_audit" remarks="Append-only change history of syllabus_extractions">
            <column name="audit_id" type="bigint" defaultValueSequenceNext="syllabus_extractions_audit_id_seq" remarks="Primary key of the audit row">
                <constraints primaryKey="true" primaryKeyName="syllabus_extractions_audit_pkey" nullable="false"/>
            </column>
            <column name="record_id" type="bigint" remarks="Id of the audited row in syllabus_extractions">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="varchar(6)" remarks="INSERT, UPDATE or DELETE">
                <constraints nullable="false"/>
            </column>
            <column name="old_data" type="jsonb" remarks="Row before the change"/>
            <column name="new_data" type="jsonb" remarks="Row after the change"/>
            <column name="changed_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Moment of the change">
                <constraints nullable="false"/>
            </column>
            <column name="db_user" type="varchar(100)" remarks="Database user that made the change"/>
            <column name="app_user_id" type="varchar(100)" remarks="Application user that made the change (smartmentor.current_user_id)"/>
        </createTable>
        <sql>ALTER TABLE syllabus_extractions_audit ADD CONSTRAINT syllabus_extractions_audit_operation_ck CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE'))</sql>
        <createIndex tableName="syllabus_extractions_audit" indexName="syllabus_extractions_audit_record_id_idx">
            <column name="record_id"/>
        </createIndex>

        <sql>CREATE TRIGGER syllabus_extractions_audit_trg AFTER INSERT OR UPDATE OR DELETE ON syllabus_extractions FOR EACH ROW EXECUTE FUNCTION audit_row_change()</sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS syllabus_extractions_audit_trg ON syllabus_extractions</sql>
            <dropTable tableName="syllabus_extractions_audit"/>
            <dropTable tableName="syllabus_extractions" cascadeConstraints="true"/>
            <dropSequence sequenceName="syllabus_extractions_audit_id_seq"/>
            <dropSequence sequenceName="syllabus_extractions_id_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
