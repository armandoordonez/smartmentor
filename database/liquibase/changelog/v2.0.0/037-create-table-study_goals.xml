<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="v2.0.0/037-create-table-study_goals.xml">

    <changeSet id="v2.0.0-037-create-table-study_goals" author="eduar.troyano">
        <comment>Crea la tabla study_goals: metas personales de estudio del aprendiz (P2). Incluye secuencia propia, tabla de auditoría study_goals_audit y el trigger study_goals_audit_trg.</comment>

        <createSequence sequenceName="study_goals_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="study_goals_audit_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="study_goals" remarks="Personal study goals of a learner (P2)">
            <column name="id" type="bigint" defaultValueSequenceNext="study_goals_id_seq" remarks="Primary key">
                <constraints primaryKey="true" primaryKeyName="study_goals_pkey" nullable="false"/>
            </column>
            <column name="user_id" type="bigint" remarks="Learner that set the goals">
                <constraints nullable="false" foreignKeyName="study_goals_user_id_fk" references="users(id)"/>
            </column>
            <column name="daily_minutes" type="smallint" remarks="Daily study minutes goal"/>
            <column name="monthly_topics" type="smallint" remarks="Topics per month goal"/>
            <column name="active" type="boolean" defaultValueBoolean="true" remarks="Logical state: false means deactivated (rows are never deleted)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Last update timestamp, maintained by the set_updated_at trigger">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="study_goals" constraintName="study_goals_user_id_uq" columnNames="user_id"/>
        <sql>ALTER TABLE study_goals ADD CONSTRAINT study_goals_values_ck CHECK ((daily_minutes IS NULL OR daily_minutes &gt; 0) AND (monthly_topics IS NULL OR monthly_topics &gt; 0))</sql>
        <sql>CREATE TRIGGER study_goals_set_updated_at_trg BEFORE UPDATE ON study_goals FOR EACH ROW EXECUTE FUNCTION set_updated_at()</sql>

        <createTable tableName="study_goals_audit" remarks="Append-only change history of study_goals">
            <column name="audit_id" type="bigint" defaultValueSequenceNext="study_goals_audit_id_seq" remarks="Primary key of the audit row">
                <constraints primaryKey="true" primaryKeyName="study_goals_audit_pkey" nullable="false"/>
            </column>
            <column name="record_id" type="bigint" remarks="Id of the audited row in study_goals">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="varchar(6)" remarks="INSERT, UPDATE or DELETE">
                <constraints nullable="false"/>
            </column>
            <column name="old_data" type="jsonb" remarks="Row before the change"/>
            <column name="new_data" type="jsonb" remarks="Row after the change"/>
            <column name="changed_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Moment of the change">
                <constraints nullable="false"/>
            </column>
            <column name="db_user" type="varchar(100)" remarks="Database user that made the change"/>
            <column name="app_user_id" type="varchar(100)" remarks="Application user that made the change (smartmentor.current_user_id)"/>
        </createTable>
        <sql>ALTER TABLE study_goals_audit ADD CONSTRAINT study_goals_audit_operation_ck CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE'))</sql>
        <createIndex tableName="study_goals_audit" indexName="study_goals_audit_record_id_idx">
            <column name="record_id"/>
        </createIndex>

        <sql>CREATE TRIGGER study_goals_audit_trg AFTER INSERT OR UPDATE OR DELETE ON study_goals FOR EACH ROW EXECUTE FUNCTION audit_row_change()</sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS study_goals_audit_trg ON study_goals</sql>
            <dropTable tableName="study_goals_audit"/>
            <dropTable tableName="study_goals" cascadeConstraints="true"/>
            <dropSequence sequenceName="study_goals_audit_id_seq"/>
            <dropSequence sequenceName="study_goals_id_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
