<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="v2.0.0/011-create-table-syllabus_documents.xml">

    <changeSet id="v2.0.0-011-create-table-syllabus_documents" author="eduar.troyano">
        <comment>Crea la tabla syllabus_documents: documentos del syllabus de un curso (reemplaza raw_syllabus y syllabus_file_path). Incluye secuencia propia, tabla de auditoría syllabus_documents_audit y el trigger syllabus_documents_audit_trg.</comment>

        <createSequence sequenceName="syllabus_documents_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="syllabus_documents_audit_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="syllabus_documents" remarks="Syllabus documents uploaded or pasted for a course (replaces raw_syllabus and syllabus_file_path)">
            <column name="id" type="bigint" defaultValueSequenceNext="syllabus_documents_id_seq" remarks="Primary key">
                <constraints primaryKey="true" primaryKeyName="syllabus_documents_pkey" nullable="false"/>
            </column>
            <column name="public_id" type="uuid" defaultValueComputed="gen_random_uuid()" remarks="Public identifier exposed by the API instead of the sequential id">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="bigint" remarks="Course the document belongs to">
                <constraints nullable="false" foreignKeyName="syllabus_documents_course_id_fk" references="courses(id)"/>
            </column>
            <column name="source_type" type="varchar(10)" remarks="Source type: pdf or text">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="varchar(300)" remarks="Original file name"/>
            <column name="file_sha256" type="char(64)" remarks="SHA-256 of the file or text, used to cache the extraction">
                <constraints nullable="false"/>
            </column>
            <column name="byte_size" type="integer" remarks="Size in bytes"/>
            <column name="page_count" type="integer" remarks="Number of pages of the PDF"/>
            <column name="extracted_char_count" type="integer" remarks="Characters extracted from the document"/>
            <column name="extracted_text" type="text" remarks="Text extracted from the document"/>
            <column name="active" type="boolean" defaultValueBoolean="true" remarks="Logical state: false means deactivated (rows are never deleted)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Last update timestamp, maintained by the set_updated_at trigger">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="syllabus_documents" constraintName="syllabus_documents_public_id_uq" columnNames="public_id"/>
        <createIndex tableName="syllabus_documents" indexName="syllabus_documents_course_id_idx">
            <column name="course_id"/>
        </createIndex>
        <createIndex tableName="syllabus_documents" indexName="syllabus_documents_file_sha256_idx">
            <column name="file_sha256"/>
        </createIndex>
        <sql>ALTER TABLE syllabus_documents ADD CONSTRAINT syllabus_documents_source_type_ck CHECK (source_type IN ('pdf', 'text'))</sql>
        <sql>CREATE TRIGGER syllabus_documents_set_updated_at_trg BEFORE UPDATE ON syllabus_documents FOR EACH ROW EXECUTE FUNCTION set_updated_at()</sql>

        <createTable tableName="syllabus_documents_audit" remarks="Append-only change history of syllabus_documents">
            <column name="audit_id" type="bigint" defaultValueSequenceNext="syllabus_documents_audit_id_seq" remarks="Primary key of the audit row">
                <constraints primaryKey="true" primaryKeyName="syllabus_documents_audit_pkey" nullable="false"/>
            </column>
            <column name="record_id" type="bigint" remarks="Id of the audited row in syllabus_documents">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="varchar(6)" remarks="INSERT, UPDATE or DELETE">
                <constraints nullable="false"/>
            </column>
            <column name="old_data" type="jsonb" remarks="Row before the change"/>
            <column name="new_data" type="jsonb" remarks="Row after the change"/>
            <column name="changed_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Moment of the change">
                <constraints nullable="false"/>
            </column>
            <column name="db_user" type="varchar(100)" remarks="Database user that made the change"/>
            <column name="app_user_id" type="varchar(100)" remarks="Application user that made the change (smartmentor.current_user_id)"/>
        </createTable>
        <sql>ALTER TABLE syllabus_documents_audit ADD CONSTRAINT syllabus_documents_audit_operation_ck CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE'))</sql>
        <createIndex tableName="syllabus_documents_audit" indexName="syllabus_documents_audit_record_id_idx">
            <column name="record_id"/>
        </createIndex>

        <sql>CREATE TRIGGER syllabus_documents_audit_trg AFTER INSERT OR UPDATE OR DELETE ON syllabus_documents FOR EACH ROW EXECUTE FUNCTION audit_row_change()</sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS syllabus_documents_audit_trg ON syllabus_documents</sql>
            <dropTable tableName="syllabus_documents_audit"/>
            <dropTable tableName="syllabus_documents" cascadeConstraints="true"/>
            <dropSequence sequenceName="syllabus_documents_audit_id_seq"/>
            <dropSequence sequenceName="syllabus_documents_id_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
