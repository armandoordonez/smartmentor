<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="v1.0.0/015-create-table-badges.xml">

    <changeSet id="v1.0.0-015-create-table-badges" author="eduar.troyano">
        <comment>Crea la tabla badges: badge digital emitido al aprobar la evaluación final (brief: Badge, 1 por ruta aprobada). Incluye secuencia propia, tabla de auditoría badges_audit y el trigger badges_audit_trg.</comment>

        <createSequence sequenceName="badges_id_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="badges_audit_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="badges" remarks="Digital badges issued when the final assessment is passed">
                <column name="id" type="bigint" defaultValueSequenceNext="badges_id_seq" remarks="Primary key">
                    <constraints primaryKey="true" primaryKeyName="badges_pkey" nullable="false"/>
                </column>
                <column name="enrollment_id" type="bigint" remarks="Enrollment that earned the badge">
                    <constraints nullable="false" foreignKeyName="badges_enrollment_id_fk" references="enrollments(id)"/>
                </column>
                <column name="issued_at" type="timestamp with time zone" remarks="Moment the badge was issued" defaultValueComputed="now()">
                    <constraints nullable="false"/>
                </column>
                <column name="image_url" type="varchar(1000)" remarks="Badge image URL"/>
                <column name="open_badges_metadata" type="jsonb" remarks="Open Badges metadata"/>
                <column name="active" type="boolean" defaultValueBoolean="true" remarks="Logical state: false means deactivated (rows are never deleted)">
                    <constraints nullable="false"/>
                </column>
                <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Creation timestamp">
                    <constraints nullable="false"/>
                </column>
        </createTable>

        <addUniqueConstraint tableName="badges" constraintName="badges_enrollment_uq" columnNames="enrollment_id"/>

        <createTable tableName="badges_audit" remarks="Append-only change history of badges">
                <column name="audit_id" type="bigint" defaultValueSequenceNext="badges_audit_id_seq" remarks="Primary key of the audit row">
                    <constraints primaryKey="true" primaryKeyName="badges_audit_pkey" nullable="false"/>
                </column>
                <column name="record_id" type="bigint" remarks="Id of the audited row in badges">
                    <constraints nullable="false"/>
                </column>
                <column name="operation" type="varchar(6)" remarks="INSERT, UPDATE or DELETE">
                    <constraints nullable="false"/>
                </column>
                <column name="old_data" type="jsonb" remarks="Row before the change"/>
                <column name="new_data" type="jsonb" remarks="Row after the change"/>
                <column name="changed_at" type="timestamp with time zone" defaultValueComputed="now()" remarks="Moment of the change">
                    <constraints nullable="false"/>
                </column>
                <column name="db_user" type="varchar(100)" remarks="Database user that made the change"/>
                <column name="app_user_id" type="varchar(100)" remarks="Application user that made the change (smartmentor.current_user_id)"/>
        </createTable>
        <sql>ALTER TABLE badges_audit ADD CONSTRAINT badges_audit_operation_ck CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE'))</sql>
        <createIndex tableName="badges_audit" indexName="badges_audit_record_id_idx">
            <column name="record_id"/>
        </createIndex>

        <sql>CREATE TRIGGER badges_audit_trg AFTER INSERT OR UPDATE OR DELETE ON badges FOR EACH ROW EXECUTE FUNCTION audit_row_change()</sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS badges_audit_trg ON badges</sql>
            <dropTable tableName="badges_audit"/>
            <dropTable tableName="badges" cascadeConstraints="true"/>
            <dropSequence sequenceName="badges_audit_id_seq"/>
            <dropSequence sequenceName="badges_id_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
