belBackgroundColor=#ffffff;" edge="1" parent="1" source="tema-v-3" target="tema-v-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tema-e-14" value="abre el tema (E6)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tema-v-4" target="tema-v-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tema-e-15" value="quiz ≥ 70 %" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tema-v-5" target="tema-v-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tema-e-16" value="quiz &lt; 70 % y&lt;br&gt;quedan intentos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tema-v-5" target="tema-v-6"><mxGeometry relative="1" as="geometry"><mxPoint x="-70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="tema-e-17" value="explicación alterna&lt;br&gt;y preguntas nuevas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tema-v-6" target="tema-v-5"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="tema-e-18" value="quiz &lt; 70 %&lt;br&gt;en el intento 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tema-v-5" target="tema-v-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="428"/></Array></mxGeometr