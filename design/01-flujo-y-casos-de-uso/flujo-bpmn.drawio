ervicio. Umbrales por defecto del brief (los define el docente por ruta): tema ≥ 70 %, máximo 3 intentos, final ≥ 80 %, omitir tema con diagnóstico ≥ 80 %. Códigos entre paréntesis: pantallas del prototipo de Figma; D0 aún no existe." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="890" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tema" name="Estados · Paso de ruta (tema)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tema-v-1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="30" height="30" as="geometry"/></mxCell><mxCell id="tema-v-2" value="Omitido" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="170" height="56" as="geometry"/></mxCell><mxCell id="tema-v-3" value="Bloqueado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="170" height="56" as="geometry"/></mxCell><mxCell id="tema-v-4" value="Pendiente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=12;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="200" y="220" width="170" height="56" as="geometry"/></mxCell><mxCell id="tema-v-5" value="En curso&lt;br&gt;(intento n de 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=12;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="240" height="56" as="geometry"/></mxCell><mxCell id="tema-v-6" value="Refuerzo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=12;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="240" height=